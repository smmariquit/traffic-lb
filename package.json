{
  "name": "traffic-lb",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "worker:dev": "cd worker && wrangler dev",
    "worker:deploy": "cd worker && wrangler deploy",
    "deploy": "pnpm run build && pnpm run worker:deploy",
    "collect:local": "curl -s http://localhost:8787/api/debug/collect | python3 -m json.tool",
    "migrate": "cd worker && wrangler d1 migrations apply traffic-lb-db --local",
    "migrate:remote": "cd worker && wrangler d1 migrations apply traffic-lb-db --remote"
  },
  "dependencies": {
    "@bettergov/kapwa": "^1.4.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "wrangler": "^4.151.0"
  }
}
